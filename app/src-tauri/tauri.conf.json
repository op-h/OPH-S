{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OPH-S",
  "version": "0.2.8",
  "identifier": "com.oph.sentinel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "OPH",
    "copyright": "DONE by OPH",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "OPH-S \u2014 personal SIEM / IDPS",
    "longDescription": "OPH-S (OPH Sentinel): network-wide DNS protection, threat intel, device monitoring, log collection and storage cleanup. DONE by OPH.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "mainBinaryName": "OPH-S"
}